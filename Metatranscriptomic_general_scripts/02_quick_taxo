#!/bin/bash
source /path/to/your/directory/miniforge/bin/activate
conda activate /path/to/your/directory/conda_singlem_0.18.3_env
R1_files=$(ls *.norRNA.R1.fastq)
R2_files=$(ls *.norRNA.R2.fastq)
# Run singlem command
singlem pipe --forward $R1_files --reverse $R2_files --threads 16 --otu-table "singlem.csv"
