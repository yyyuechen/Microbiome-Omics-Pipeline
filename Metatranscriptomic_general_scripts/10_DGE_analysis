#Here I did DGE analysis in R

#Here I used Wilcoxon rank-sum test as suggested by: 
#Li, Y., Ge, X., Peng, F. et al. Exaggerated false positives by popular differential expression methods when analyzing human population samples. Genome Biol 23, 79 (2022). https://doi.org/10.1186/s13059-022-02648-4

#**Wilcoxon rank-sum test**
# read data
setwd("~/path/to/your/directory")
readCount <- read.table("RSEM.isoform.counts.matrix",header = T, row.names = 1, stringsAsFactors = F,check.names = F)
conditions <- read.csv("~sample_condition.csv",header = T, row.names = 1, stringsAsFactors = F,check.names = F)

# edger TMM normalize
y <- DGEList(counts=readCount, genes = row.names(readCount),group=as.factor(conditions$Niskin_bottle))
keep <- rowSums(cpm(y)>1) >= 6 
y <- y[keep,keep.lib.sizes=FALSE]

##Remove rows conssitently have zero or very low counts
keep <- filterByExpr(y)
y <- y[keep,keep.lib.sizes=FALSE]

##Perform TMM normalization and transfer to CPM (Counts Per Million)
y <- calcNormFactors(y,method="TMM")
count_norm=cpm(y)
count_norm<-as.data.frame(count_norm)

# Run the Wilcoxon rank-sum test for each gene

pvalues <- sapply(1:nrow(count_norm),function(i){
  data<-cbind.data.frame(gene=as.numeric(t(count_norm[i,])),conditions)
  p=wilcox.test(gene~conditions$Niskin_bottle, data)$p.value
  return(p)
})
fdr=p.adjust(pvalues,method = "fdr")

# Calculate fold-change for each gene
conditionsLevel<-levels(conditions$Niskin_bottle)
conditionsLevel <- unique(conditions$Niskin_bottle)
dataCon1=count_norm[,c(which(conditions$Niskin_bottle==conditionsLevel[1]))]
dataCon2=count_norm[,c(which(conditions$Niskin_bottle==conditionsLevel[2]))]
foldChanges=log2(rowMeans(dataCon2)/rowMeans(dataCon1))

# Output results based on FDR threshold
outRst<-data.frame(log2foldChange=foldChanges, pValues=pvalues, FDR=fdr)
rownames(outRst)=rownames(count_norm)
outRst=na.omit(outRst)
fdrThres=0.1
outRst_FDR0.1_afifirna <- outRst[outRst$FDR<fdrThres,]
write.table(outRst[outRst$FDR<fdrThres,], file="WilcoxonTest.rst.tsv",sep="\t", quote=F,row.names = T,col.names = T)


