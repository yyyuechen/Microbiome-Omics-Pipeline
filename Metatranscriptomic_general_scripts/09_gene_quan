#!/bin/bash

module load rsem/1.3.3

align_and_estimate_abundance.pl --transcripts trinity_cdhit.fasta --seqType fq \
 --est_method RSEM --aln_method bowtie2 --thread_count 34 \
 --prep_reference --trinity_mode --output_dir rsem_outdir  --samples_file /path/to/your/directory/sample_cond.txt

#this step resulted in 2 files:
#RSEM.isoforms.results : EM read counts per Trinity transcript
#RSEM.genes.results : EM read counts on a per-Trinity-component (aka… gene) basis, ‘gene’ used loosely here.

ls */*RSEM.isoforms.results > countfile.txt

abundance_estimates_to_matrix.pl --est_method RSEM \
 --gene_trans_map none --quant_files countfile.txt --name_sample_by_basedir

